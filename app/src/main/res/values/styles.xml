<resources>

    <style name="CalcButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">68dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Regular number buttons -->
    <style name="CalcButtonGray" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_number_bg</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Orange operator buttons -->
    <style name="CalcButtonOrange" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_orange_bg</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Clear / function buttons -->
    <style name="CalcButtonRed" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_function_bg</item>
        <item name="android:textColor">#1C1C1E</item>
    </style>

    <!-- % and backspace buttons -->
    <style name="CalcButtonFunction" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_function_bg</item>
        <item name="android:textColor">#1C1C1E</item>
    </style>

</resources>