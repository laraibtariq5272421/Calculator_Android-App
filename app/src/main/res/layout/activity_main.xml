<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_bg"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="36dp"
        android:paddingBottom="18dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculator"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_display">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvExpression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_expression"
                    android:textSize="20sp"
                    android:gravity="end"
                    android:maxLines="2"
                    android:ellipsize="start" />

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="46sp"
                    android:textStyle="bold"
                    android:gravity="end"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Button Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="10dp"
        android:layout_marginBottom="28dp">

        <Button android:id="@+id/btnClear" android:text="C" style="@style/CalcButtonRed"/>
        <Button android:id="@+id/btnBackspace" android:text="⌫" style="@style/CalcButtonFunction"/>
        <Button android:id="@+id/btnPercent" android:text="%" style="@style/CalcButtonFunction"/>
        <Button android:id="@+id/btnDivide" android:text="÷" style="@style/CalcButtonOrange"/>

        <Button android:id="@+id/btn7" android:text="7" style="@style/CalcButtonGray"/>
        <Button android:id="@+id/btn8" android:text="8" style="@style/CalcButtonGray"/>
        <Button android:id="@+id/btn9" android:text="9" style="@style/CalcButtonGray"/>
        <Button android:id="@+id/btnMultiply" android:text="×" style="@style/CalcButtonOrange"/>

        <Button android:id="@+id/btn4" android:text="4" style="@style/CalcButtonGray"/>
        <Button android:id="@+id/btn5" android:text="5" style="@style/CalcButtonGray"/>
        <Button android:id="@+id/btn6" android:text="6" style="@style/CalcButtonGray"/>
        <Button android:id="@+id/btnMinus" android:text="−" style="@style/CalcButtonOrange"/>

        <Button android:id="@+id/btn1" android:text="1" style="@style/CalcButtonGray"/>
        <Button android:id="@+id/btn2" android:text="2" style="@style/CalcButtonGray"/>
        <Button android:id="@+id/btn3" android:text="3" style="@style/CalcButtonGray"/>
        <Button android:id="@+id/btnPlus" android:text="+" style="@style/CalcButtonOrange"/>

        <Button android:id="@+id/btn0" android:text="0" style="@style/CalcButtonGray"
            android:layout_columnSpan="2"
            android:layout_width="0dp"
            android:layout_columnWeight="2"/>
        <Button android:id="@+id/btnDot" android:text="." style="@style/CalcButtonGray"/>
        <Button android:id="@+id/btnEquals" android:text="=" style="@style/CalcButtonOrange"/>

    </GridLayout>

</LinearLayout>